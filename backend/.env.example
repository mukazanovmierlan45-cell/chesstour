APP_NAME="Шахматные турниры"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

LOG_CHANNEL=daily
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chess_tournaments
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log

# ПР8: время жизни токена Sanctum, минуты
SANCTUM_EXPIRATION=1440

# ПР11: адрес клиентского приложения (через запятую, без «*»)
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# ИИ-ассистент (Google Gemini). Ключ: https://aistudio.google.com/apikey — не коммитить!
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ИИ-ассистент: провайдер gemini или groq
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
